<!doctype html>
<html>
<head>
  <meta charset="utf-8">
  <script src="./support.js"></script>
</head>
<body>
<x-dc>
<helmet>
  <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Noto+Sans+SC:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap">
  <style>
    body { margin: 0; }
    a { color: #9c3417; text-decoration: none; }
    a:hover { color: #7d290f; }
    .th {
      height: 34px;
      padding: 0 12px;
      text-align: left;
      white-space: nowrap;
      border-bottom: 1px solid #e4e0d8;
      background: #f2efe9;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 11px;
      font-weight: 500;
      letter-spacing: 0.025em;
      color: #79736a;
    }
    .th b { font-weight: 400; color: #a09a90; }
    .td { padding: 9px 12px; vertical-align: top; border-bottom: 1px solid #eae7e0; }
    .pair { font-size: 12px; line-height: 1.45; color: #1a1917; }
    .sum { display: block; margin-top: 2px; font-family: "JetBrains Mono", ui-monospace, monospace; font-size: 11px; color: #79736a; }
    .over { color: #b8860b; }
    .sel {
      display: flex;
      height: 36px;
      align-items: center;
      justify-content: space-between;
      gap: 8px;
      box-sizing: border-box;
      border-radius: 8px;
      border: 1px solid #e4e0d8;
      background: #ffffff;
      padding: 0 10px;
      font-size: 12.5px;
      color: #1a1917;
    }
    .selph { color: #a09a90; }
    .lineTag { width: 46px; flex: none; }
    .lineTag b {
      display: block;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 11.5px;
      font-weight: 500;
      letter-spacing: 0.06em;
      color: #9c3417;
    }
    .lineTag i {
      display: block;
      font-style: normal;
      font-family: "JetBrains Mono", ui-monospace, monospace;
      font-size: 10px;
      color: #a09a90;
    }
    .chk { display: inline-flex; align-items: center; gap: 4px; font-size: 11.5px; color: #79736a; }
  </style>
</helmet>

